# --- "Miya" (LLM) tanlash ---
# anthropic = Claude (pullik, eng sifatli) | openai = OpenAI-mos API (Gemini bepul, Groq bepul, Ollama lokal)
BIT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# BIT_LLM_PROVIDER=openai boʻlsa, quyidagi variantlardan BITTASINI yoqing:
# 1) Google Gemini (bepul tier) — kalit: aistudio.google.com -> Get API key
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gemini-3.5-flash-lite
# band yoki limitga tushsa, navbat bilan sinaladi
OPENAI_MODEL_FALLBACKS=gemini-flash-lite-latest,gemini-3.5-flash,gemini-3.8-flash
OPENAI_MODEL_SMART=
# sekin "oʻylaydigan" modellar uchun: none yoki low (tezroq javob)
OPENAI_REASONING_EFFORT=
BIT_LLM_TIMEOUT=60
# 2) Groq (bepul tier) — kalit: console.groq.com
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL_FAST=llama-3.3-70b-versatile
# 3) Ollama (lokal, internetsiz) — avval: ollama pull qwen2.5:7b
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL_FAST=qwen2.5:7b

# --- majburiy ---
# Ilovaga kirish paroli. Yaratish:  python -c "import secrets;print(secrets.token_urlsafe(32))"
BIT_API_TOKEN=

# --- model va xulq ---
BIT_MODEL_FAST=claude-haiku-5-5
BIT_MODEL_SMART=claude-sonnet-5-5
# 0 = hamma amal uchun ruxsat soʻraydi, 1 = faqat xavfli amallar uchun (tavsiya), 2 = soʻramaydi
BIT_AUTONOMY=1
TZ=Asia/Tashkent

# --- Ovoz ---
# edge = serverdan tabiiy neyron ovoz (tavsiya), browser = brauzer ovozlari
BIT_TTS=edge
BIT_TTS_VOICE_UZ=uz-UZ-SardorNeural
BIT_TTS_VOICE_RU=ru-RU-DmitryNeural
BIT_TTS_VOICE_EN=en-US-GuyNeural
BIT_TTS_PITCH=+25Hz

# --- Telegram (ixtiyoriy) — my.telegram.org -> API development tools ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# scripts/telegram_login.py chiqargan qator
TELEGRAM_SESSION=
TELEGRAM_MAX_PER_HOUR=20

# --- HTTPS (VPS + domen boʻlsa) ---
DOMAIN=bit.example.uz
